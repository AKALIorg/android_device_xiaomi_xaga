// Full (non-stub) Chromium stack for xaga GAPPS builds.
// Upstream vendor/pixel/gms only ships *-Stub packages (empty shells that
// need Play Store to hydrate); without network, Chrome/WebView render
// nothing. These full APKs are extracted from the .apk.gz dumps in
// vendor/pixel/gms and installed instead (stubs filtered out in
// infinity_xaga.mk). GAPPS-only: keep vanilla builds clean.

android_app_import {
    name: "Chrome",
    owner: "xiaomi",
    apk: "Chrome.apk",
    preprocessed: true,
    presigned: true,
    dex_preopt: {
        enabled: false,
    },
    product_specific: true,
}

android_app_import {
    name: "TrichromeLibrary",
    owner: "xiaomi",
    apk: "TrichromeLibrary.apk",
    preprocessed: true,
    presigned: true,
    dex_preopt: {
        enabled: false,
    },
    product_specific: true,
}

android_app_import {
    name: "WebViewGoogle",
    owner: "xiaomi",
    apk: "WebViewGoogle.apk",
    preprocessed: true,
    presigned: true,
    dex_preopt: {
        enabled: false,
    },
    product_specific: true,
}
